APP_DEBUG=false
SQL_DEBUG=false
APP_URL=http://127.0.0.1:8787
PUBLIC_LINK_BASE_URL=http://127.0.0.1:8787

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=flyim_community
DB_USERNAME=flyim_community
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# 联系方式检索HMAC密钥，用于生成手机号、邮箱的确定性查询摘要；生产环境至少32字节且需独立生成。
AUTH_CONTACT_LOOKUP_KEY=
# 联系方式加密密钥，用于加密保存手机号、邮箱原文；必须与检索密钥不同并妥善备份。
AUTH_CONTACT_ENCRYPTION_KEY=
# App端Refresh Token哈希密钥，用于不可逆保存刷新令牌；生产环境至少32字节且需独立生成。
AUTH_REFRESH_TOKEN_KEY=
# 验证码哈希密钥，用于不可逆保存短信或邮箱验证码；生产环境至少32字节且需独立生成。
AUTH_VERIFICATION_CODE_KEY=
# App端JWT签名密钥标识，密钥轮换时用于区分签名密钥版本。
AUTH_JWT_KEY_ID=main-2026-01
# App端JWT Ed25519私钥，仅由API服务持有，禁止提交到版本库或下发给客户端。
AUTH_JWT_PRIVATE_KEY=
# App端JWT Ed25519公钥，用于服务端验签，可随私钥轮换同步更新。
AUTH_JWT_PUBLIC_KEY=
# App端JWT签发者标识，签发与验签配置必须完全一致。
AUTH_JWT_ISSUER=chat-fly-service
# App端JWT受众标识，用于阻止管理后台Token与App Token混用。
AUTH_JWT_AUDIENCE=chat-fly-app

# 验证码发送驱动；fixed仅限本地或测试环境，生产环境必须替换为真实短信或邮件驱动。
AUTH_VERIFICATION_DRIVER=fixed
# fixed驱动返回的固定验证码，仅限本地或测试环境，生产环境必须留空。
AUTH_FIXED_VERIFICATION_CODE=123456
# 是否允许调试响应暴露验证码；仅APP_DEBUG=true时生效，生产环境必须设为false。
AUTH_EXPOSE_VERIFICATION_CODE=false

RUSTFS_ENDPOINT=http://127.0.0.1:9000
RUSTFS_SERVER_ENDPOINT=http://127.0.0.1:9000
RUSTFS_PUBLIC_ENDPOINT=http://127.0.0.1:9000
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=chat
RUSTFS_REGION=us-east-1
RUSTFS_PATH_STYLE=true
RUSTFS_SSL_VERIFY=false

# Centrifugo 未部署前保持 false；启用后必须配置 API Key 和 JWT HMAC 密钥。
CENTRIFUGO_ENABLED=false
CENTRIFUGO_API_URL=http://127.0.0.1:8000
CENTRIFUGO_PUBLIC_WS_URL=ws://127.0.0.1:8000/connection/websocket
CENTRIFUGO_API_KEY=
CENTRIFUGO_TOKEN_HMAC_SECRET=
CENTRIFUGO_TOKEN_TTL_SECONDS=300
CENTRIFUGO_REQUEST_TIMEOUT_SECONDS=3
CENTRIFUGO_OUTBOX_INTERVAL_SECONDS=0.5
CENTRIFUGO_OUTBOX_BATCH_SIZE=100
CENTRIFUGO_OUTBOX_MAX_RETRIES=8
CENTRIFUGO_OUTBOX_RETRY_BASE_SECONDS=2
CENTRIFUGO_OUTBOX_RETRY_MAX_SECONDS=300
CENTRIFUGO_OUTBOX_LOCK_SECONDS=15
CENTRIFUGO_OUTBOX_WORKER_COUNT=1
PRESENCE_SHARD_COUNT=256
PRESENCE_LISTENER_STALE_SECONDS=20
# Webman Presence Listener建议使用Centrifugo内网WebSocket地址。
PRESENCE_LISTENER_WS_URL=ws://127.0.0.1:8022/connection/websocket
PRESENCE_LISTENER_TOKEN_TTL_SECONDS=3600
PRESENCE_OFFLINE_GRACE_SECONDS=5
PRESENCE_RECONCILE_SECONDS=60
PRESENCE_HEALTH_LISTEN=http://127.0.0.1:9092
